digraph UML {
  graph [rankdir=LR, nodesep=0.45, ranksep=0.8, bgcolor=white, pad=0.3];
  node [shape=plain, fontname="DejaVu Sans", fontsize=13];
  edge [fontname="DejaVu Sans", fontsize=12, color="#37474F"];
  PatientRegistry [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E3F2FD" color="#1565C0"><tr><td bgcolor="#1565C0" align="center"><font color="white"><b>PatientRegistry</b></font></td></tr><tr><td align="left">- _patients : dict[str, Patient]</td></tr><tr><td align="left">- _workers : dict[str, HealthWorker]</td></tr><tr><td align="left" border="1" sides="t">+ add_patient(patient) / add_worker(worker)</td></tr><tr><td align="left">+ get_patient(id) / get_worker(id)</td></tr><tr><td align="left">+ display_patients() / display_workers()</td></tr><tr><td align="left">+ diagnosis_summary() : tuple</td></tr><tr><td align="left">+ follow_up_list() : tuple</td></tr><tr><td align="left">+ patients_with(diagnosis) : tuple</td></tr><tr><td align="left">+ export_statistics(path) : tuple</td></tr><tr><td align="left">+ with_sample_data()  «classmethod»</td></tr><tr><td align="left">+ format_counts(rows)  «staticmethod»</td></tr></table>>];
  HealthWorker [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5" color="#6A1B9A"><tr><td bgcolor="#6A1B9A" align="center"><font color="white"><b>HealthWorker</b></font></td></tr><tr><td align="left">+ worker_id : str</td></tr><tr><td align="left">+ role : str</td></tr><tr><td align="left">+ district : str</td></tr><tr><td align="left">+ visits_recorded : int</td></tr><tr><td align="left" border="1" sides="t">+ record_visit(patient, date, type, diagnosis, vitals)</td></tr><tr><td align="left">+ display_info() : str</td></tr><tr><td align="left">+ generate_id()  «classmethod»</td></tr><tr><td align="left">+ roles()  «classmethod»</td></tr><tr><td align="left">+ parse_date(value)  «staticmethod»</td></tr><tr><td align="left">+ build_vitals(temp, weight, sys, dia)  «staticmethod»</td></tr><tr><td align="left">+ parse_blood_pressure(text)  «staticmethod»</td></tr></table>>];
  Patient [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5E9" color="#2E7D32"><tr><td bgcolor="#2E7D32" align="center"><font color="white"><b>Patient</b></font></td></tr><tr><td align="left">+ patient_id : str</td></tr><tr><td align="left">+ age : int</td></tr><tr><td align="left">+ sex : str</td></tr><tr><td align="left">+ district : str</td></tr><tr><td align="left">- _visits : tuple[Visit]</td></tr><tr><td align="left" border="1" sides="t">+ add_visit(visit)</td></tr><tr><td align="left">+ visit_count() : int</td></tr><tr><td align="left">+ latest_visit()</td></tr><tr><td align="left">+ has_condition(diagnosis) : bool</td></tr><tr><td align="left">+ needs_follow_up() : tuple</td></tr><tr><td align="left">+ update_record(age, district)</td></tr><tr><td align="left">+ display_info() : str</td></tr><tr><td align="left">+ generate_id()  «classmethod»</td></tr><tr><td align="left">+ from_tuple(data)  «classmethod»</td></tr><tr><td align="left">+ validate_age(value)  «staticmethod»</td></tr><tr><td align="left">+ age_group(age)  «staticmethod»</td></tr></table>>];
  Visit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF3E0" color="#EF6C00"><tr><td bgcolor="#EF6C00" align="center"><font color="white"><b>Visit</b><br/>«NamedTuple, immutable»</font></td></tr><tr><td align="left">+ visit_date : date</td></tr><tr><td align="left">+ visit_type : str</td></tr><tr><td align="left">+ diagnosis : str</td></tr><tr><td align="left">+ vitals : VitalSigns</td></tr><tr><td align="left">+ worker_id : str</td></tr></table>>];
  VitalSigns [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FCE4EC" color="#AD1457"><tr><td bgcolor="#AD1457" align="center"><font color="white"><b>VitalSigns</b><br/>«NamedTuple, immutable»</font></td></tr><tr><td align="left">+ temperature_c : float</td></tr><tr><td align="left">+ weight_kg : float</td></tr><tr><td align="left">+ systolic : int | None</td></tr><tr><td align="left">+ diastolic : int | None</td></tr><tr><td align="left" border="1" sides="t">+ has_fever() : bool</td></tr><tr><td align="left">+ bp_category() : str</td></tr><tr><td align="left">+ summary() : str</td></tr></table>>];
  PatientRegistry -> HealthWorker [label="stores 0..*\n(dict by ID)", dir=back, arrowtail=odiamond, arrowhead=none];
  PatientRegistry -> Patient [label="stores 0..*\n(dict by ID)", dir=back, arrowtail=odiamond, arrowhead=none];
  HealthWorker -> Patient [label="records visits for", arrowhead=vee, constraint=false];
  Patient -> Visit [label="has 0..*\n(tuple)", dir=back, arrowtail=diamond, arrowhead=none];
  Visit -> VitalSigns [label="has 1", dir=back, arrowtail=diamond, arrowhead=none];
}